---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title="Projects" sideBarActiveItemID="projects">
  <div>
    <div class="text-3xl w-full font-bold mb-5">Projects ⚒️</div>
  </div>

  <HorizontalCard
    title="Instahot"
    img="/instahot.png"
    desc=`An E-commerce website that enables user to buy and sell their products. This website is created with Laravel and MySQL as backend and Tailwind with Livewire as frontend frameworks.`
    url="https://instahotdili.duckdns.org/tl"
    badge="Recently"
  />

  <HorizontalCard
    title="Ailok TV"
    img="/ailoktv.png"
    desc=`A streaming website that enables user to watch live football matches 
    and other sports. This website is created with Tailwind, React JS and Shaka Player.`
    url="https://ailok-bola-w1.vercel.app/"
  />

  <HorizontalCard
    title="Weather Restful API of Timor-Leste"
    img="/weatherapi.JPG"
    desc=`This Restful API application created to engaged all the municipality Weather 
    data across East Timor. This backend of the Restful API created with PHP (Laravel Framework) 
    with MySQL.`
    url="https://weather-api-timor-leste.vercel.app/"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Todolist App"
    img="/todolist.JPG"
    desc=`This todolist app is created to store all the list
  of activities of the user. The stack to created
  the website is used Laravel, MySQL and
  Livewire.`
    url="https://todolist-livewire.vercel.app/"
  />

  <div class="divider my-0"></div>
  <HorizontalCard
    title="Shop Ailok"
    img="/shop.JPG"
    desc=`A Simple CRM website that enables user
    and seller to sell their products and make
    transaction between them. This website is
    created with Django as the Framework and
    MySQL`
    url="https://github.com/Frederico27/Shop-Ailok"
  />
</BaseLayout>
